# Little Moon — Environment Variables Template
# Copy this file to .env.local for local development. Never commit real credentials to version control.

# -----------------------------------------------------------------------------
# Frontend Client Configuration (Vite Public Variables)
# Safe for exposure in browser bundles — protected by PostgreSQL Row Level Security (RLS)
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# -----------------------------------------------------------------------------
# Backend / Supabase Edge Functions Secrets
# DO NOT set these in frontend .env files!
# Set these in your Supabase Dashboard under: Project Settings -> Edge Functions -> Secrets
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# AI_PROVIDER=gemini # Options: gemini | claude | openai
# AI_API_KEY=your-secure-ai-api-key
